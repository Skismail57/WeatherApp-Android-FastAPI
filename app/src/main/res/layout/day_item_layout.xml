<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:minHeight="175dp"
    android:background="@drawable/day_block_bg">

    <com.github.ybq.android.spinkit.SpinKitView
        android:id="@+id/day_progress_bar"
        style="@style/SpinKitView.FadingCircle"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_centerInParent="true"
        android:visibility="visible"
        app:SpinKit_Color="@color/textColor" />

    <LinearLayout
        android:id="@+id/day_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="visible">

        <!-- Day Header -->
        <RelativeLayout
            android:id="@+id/top_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/koho_regular"
                android:text="@string/day"
                android:textAllCaps="true"
                android:textColor="@color/textColor"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/day_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/koho_regular"
                android:text=""
                android:textAllCaps="true"
                android:textColor="@color/textColor"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </RelativeLayout>

        <!-- Weather Icon -->
        <ImageView
            android:id="@+id/day_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Temperature -->
        <TextView
            android:id="@+id/day_temperature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/koho_regular"
            android:gravity="center"
            android:text="20°C / 31°C"
            android:textColor="@color/textColor"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Pressure -->
        <TextView
            android:id="@+id/day_pressure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/koho_regular"
            android:gravity="center"
            android:text="1009 mb"
            android:textColor="@color/textColor"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Wind -->
        <TextView
            android:id="@+id/day_wind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/koho_regular"
            android:gravity="center"
            android:text="5 km/h"
            android:textColor="@color/textColor"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Humidity -->
        <TextView
            android:id="@+id/day_humidity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/koho_regular"
            android:gravity="center"
            android:text="46%"
            android:textColor="@color/textColor"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</RelativeLayout>